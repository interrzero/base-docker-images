# Using the custom NGINX image from chainguard
FROM cgr.dev/chainguard/nginx:latest-dev@sha256:8282208478775661eed085c6c226de1e079960b48a040e7ad4d3511464f35ae6 AS builder

# Switching to root user for package installation
USER root

# Installing required packages for building NGINX
RUN apk update && apk --no-cache add -u perl wget build-base pcre-dev zlib-dev curl openssl-dev

# Define NGINX and additional compatible module versions
# https://github.com/openresty/headers-more-nginx-module/?tab=readme-ov-file#compatibility
ARG NGINX_VERSION=1.29.3
ARG MORE_HEADERS_VERSION=0.37

WORKDIR /usr/src/

# Download NGINX and headers-more-nginx-module sources
RUN wget "http://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -O nginx.tar.gz && \
	wget "https://github.com/openresty/headers-more-nginx-module/archive/v${MORE_HEADERS_VERSION}.tar.gz" -O extra_module.tar.gz

# Make dirs for nginx and extract sources
RUN mkdir -p /usr/src/nginx /usr/src/extra_module /var/log/nginx /etc/nginx/conf.d /var/cache/nginx /var/lib/nginx/modules && chown -R nginx:nginx /var/lib/nginx/ && \
	tar -xzf nginx.tar.gz -C /usr/src/nginx --strip-components=1 && \
	tar -xzf extra_module.tar.gz -C /usr/src/extra_module --strip-components=1

# Compile and install NGINX with additional module
WORKDIR /usr/src/nginx
RUN ./configure --prefix=/usr/local/nginx \
                --with-compat \
                --add-dynamic-module=/usr/src/extra_module && \
    make -j$(($(nproc)/2)) modules && \
    make -j$(($(nproc)/2)) install

# Clean up
RUN rm -rf nginx nginx.tar.gz extra_module extra_module.tar.gz

# Record what this image contains, the same way every other image in the fleet
# does. The release pipeline extracts /tmp/versions.txt into the release notes,
# and an image without one is silently omitted from them.
#
# It is written here rather than in the final stage because that stage is
# cgr.dev/chainguard/nginx:latest, which is distroless - no shell, so no RUN can
# generate it there. The values come from the build ARGs above, which are the
# authoritative source for what was actually compiled.
RUN { \
      echo "nginx=${NGINX_VERSION}"; \
      echo "nginx_major_tag=$(echo "${NGINX_VERSION}" | cut -d. -f1)"; \
      echo "nginx_minor_tag=$(echo "${NGINX_VERSION}" | cut -d. -f1-2)"; \
      echo "more_headers=${MORE_HEADERS_VERSION}"; \
    } > /tmp/versions.txt && \
    chmod 0644 /tmp/versions.txt && \
    cat /tmp/versions.txt

# Switch back to non-root user
USER nginx

# Set the shell for subsequent commands
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# Start the second stage of the Dockerfile
FROM cgr.dev/chainguard/nginx:latest@sha256:a104d1995e56b7a15e8f152078dfbdb1ecbf9f9d1af311e7906e7b4c0c790cf2

# Copy compiled modules only if the directory exists
COPY --from=builder /usr/local/nginx/modules/*.so /var/lib/nginx/modules/

# Carry the version record across from the builder. The final stage is
# distroless, so this cannot be generated here.
COPY --from=builder /tmp/versions.txt /tmp/versions.txt

# Health Check
HEALTHCHECK --interval=30s --timeout=3s \
# CMD curl -f http://localhost/ || exit 1
CMD nginx -t || exit 1

# Set the user for subsequent commands
USER nginx

# Copy NGINX configuration
COPY nginx.conf /etc/nginx/nginx.conf

# End of Dockerfile

