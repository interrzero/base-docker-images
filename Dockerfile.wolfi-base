FROM cgr.dev/chainguard/wolfi-base:latest@sha256:bef0f4d47edc72a93d1537eae54eb53db2b2cc352c028128ff0f16c5b5a3c1e4

# Apply outstanding security updates at build time.
#
# Without this the image can only ever be as current as the pinned base digest,
# so a rebuild triggered by the daily vulnerability scan reproduces the same
# vulnerable packages and the scan finds them again the next day. That loop ran
# for days: the base already carried fixed glibc and busybox while this image
# kept shipping the old ones.
#
# The base image records exact "pkg=version" constraints in /etc/apk/world, which
# makes a plain "apk upgrade" a no-op for those packages: the solver honours the
# pin and leaves them behind. Relaxing the exact pins to bare names first is what
# allows security updates to actually apply. Verified on apk-tools 2 and 3.
# The "=[0-9]" anchor deliberately leaves fuzzy "=~" pins (e.g. nodejs=~24) alone.
USER root
RUN sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache

# Record what this image actually contains, the same way every other image in
# the fleet does. The release pipeline extracts /tmp/versions.txt into the
# release notes, and an image without one is silently omitted from them.
# wolfi-base has no language runtime to report, so it records the packages that
# define it - the ones a consumer inherits and that CVE scans land on.
SHELL ["/bin/sh", "-o", "pipefail", "-c"]
# Wolfi uses version-streamed package NAMES (glibc-2.44, openssl-4.0-libcrypto),
# so stripping a fixed "name-" prefix leaves junk like "2.44-2.44-r7". Capture
# the trailing <version>-r<release> instead, which is name-agnostic.
RUN pkgver() { apk info -v 2>/dev/null | grep -E "^$1-[0-9]" | head -n1 | sed -E 's/.*-([0-9][^-]*-r[0-9]+)$/\1/'; }; \
    { \
      echo "base=wolfi"; \
      echo "glibc=$(pkgver glibc)"; \
      echo "busybox=$(pkgver busybox)"; \
      echo "zlib=$(pkgver zlib)"; \
      echo "openssl=$(apk info -v 2>/dev/null | grep -E '^openssl' | head -n1 | sed -E 's/.*-([0-9][^-]*-r[0-9]+)$/\1/')"; \
    } > /tmp/versions.txt && \
    chmod 0644 /tmp/versions.txt && \
    cat /tmp/versions.txt

USER nonroot
