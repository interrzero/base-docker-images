FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1f6b749929164c3d9e7cad0289254f39b2ba51e1dddaeb0fa57532ea03f2db31

# The base image records exact "pkg=version" constraints in /etc/apk/world, which
# makes a plain "apk upgrade" a no-op for those packages: the solver honours the
# pin and leaves them behind. Relaxing the exact pins to bare names first is what
# allows security updates to actually apply. Verified on apk-tools 2 and 3.
# The "=[0-9]" anchor deliberately leaves fuzzy "=~" pins (e.g. nodejs=~24) alone.
# The upgrade-by-name pipeline below sets pipefail inline (busybox ash supports
# it); hadolint only recognises pipefail set by SHELL, and a SHELL change here
# would also apply to the later RUNs.
# hadolint ignore=DL4006,SC3040
RUN sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk add --no-cache go-1.25 bash build-base git && \
    # Upgrade by name every package still older than the repository offers (the
    # publish gate's freshness list): a plain "apk upgrade" can leave a package
    # pulled in by "apk add" behind, as libpng 1.6.59-r1 did when Wolfi split it.
    apk update && \
    set -o pipefail && apk version -l '<' | tail -n +2 | awk '{print $1}' \
        | sed -E 's/-[0-9][^-]*-r[0-9]+$//' \
        | xargs -r apk add --no-cache --upgrade

USER nonroot
WORKDIR /workspace

# Extract Go version information and save to /tmp/versions.txt
SHELL ["/bin/sh", "-o", "pipefail", "-c"]
RUN go version > /tmp/go_version.txt && \
    GO_VERSION=$(go version | cut -d' ' -f3 | sed 's/go//') && \
    echo "go=${GO_VERSION}" > /tmp/versions.txt && \
    GO_MAJOR=$(echo "${GO_VERSION}" | cut -d'.' -f1) && \
    GO_MINOR="${GO_MAJOR}.$(echo "${GO_VERSION}" | cut -d'.' -f2)" && \
    echo "go_major_tag=${GO_MAJOR}" >> /tmp/versions.txt && \
    echo "go_minor_tag=${GO_MINOR}" >> /tmp/versions.txt && \
    cat /tmp/versions.txt
