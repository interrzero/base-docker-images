FROM cgr.dev/chainguard/wolfi-base:latest@sha256:00fd4e9cdd9c5576c336d979fa663f9976f160c456b6ae9fe87e19c4e9c759a2 AS builder

# Install Node.js, npm and Yarn
# npm is deliberately NOT pinned to a major. Wolfi tracks npm independently of
# the Node major, and holding it at 11.x reintroduces the tar and
# brace-expansion advisories (CVE-2026-59871/3/4/5, CVE-2026-13149/14257) whose
# only fix is npm >= 12.0.1-r2. The installed version is recorded in
# /tmp/versions.txt so major drift stays visible to consumers.
# The base image records exact "pkg=version" constraints in /etc/apk/world, which
# makes a plain "apk upgrade" a no-op for those packages: the solver honours the
# pin and leaves them behind. Relaxing the exact pins to bare names first is what
# allows security updates to actually apply. Verified on apk-tools 2 and 3.
# The "=[0-9]" anchor deliberately leaves fuzzy "=~" pins (e.g. nodejs=~24) alone.
RUN sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk add --no-cache 'nodejs=~24' yarn npm

# Raise npm's vendored dependencies to their fixed versions.
#
# npm ships a full node_modules tree of its own dependencies. Scanners read
# those package.json files as an inventory, so a vendored copy that has fallen
# behind surfaces as an image vulnerability even when npm itself is current.
# Verified: npm 12.1.0, the newest Wolfi ships, still vendors
# brace-expansion 5.0.10 and ip-address 10.5.1, while the fixes are published.
# Upgrading npm does not help - npm chooses what it vendors - and the copies
# cannot be deleted because npm imports them at runtime.
#
# Targets are named with a fix floor rather than swept: replacing every
# vendored package with the newest its range allowed broke npm (`npm view`
# failed silently), because npm tests that tree as a unit. Same approach as
# harden-pip-vendor.py. The floor is not a pin - the newest version satisfying
# both the floor and npm's own declared range is installed, so a later fix
# needs no edit here.
#
# Run twice deliberately: the second run must report every target already at or
# above its floor, which is the idempotency check.
COPY scripts/harden-node-vendor.js /tmp/harden-node-vendor.js
RUN node /tmp/harden-node-vendor.js /usr/lib/node_modules/npm && \
    node /tmp/harden-node-vendor.js /usr/lib/node_modules/npm && \
    npm --version >/dev/null && npm help >/dev/null && \
    npm view semver version >/dev/null && \
    echo "npm functional after vendor hardening" && \
    rm -f /tmp/harden-node-vendor.js

# Extract Node.js version and save to file
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN node --version | awk -F'v' '{print $2}' | tr -d '\n' > /tmp/temp_node_version.txt

# Create symbolic link to match the installed Node.js version
RUN NODE_VERSION=$(cat /tmp/temp_node_version.txt) && \
    mkdir -p /usr/local/nvm/versions/node && \
    ln -s "/usr/local/nvm/versions/node/v${NODE_VERSION}/" /usr/local/nvm/versions/node/current

# Save Node.js version
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN NODE_VERSION=$(node --version | sed 's/v//') && \
    echo "nodejs_major_tag=$(echo $NODE_VERSION | cut -d'.' -f1)" > /tmp/versions.txt && \
    echo "nodejs_minor_tag=$(echo $NODE_VERSION | cut -d'.' -f1-2)" >> /tmp/versions.txt && \
    echo "nodejs=$NODE_VERSION" >> /tmp/versions.txt && \
    echo "npm=$(npm --version)" >> /tmp/versions.txt && \
    echo "yarn=$(yarn --version)" >> /tmp/versions.txt

RUN cat /tmp/versions.txt

USER nobody

