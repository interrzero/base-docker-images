FROM cgr.dev/chainguard/wolfi-base:latest@sha256:c08875f557c44f2e376d40ab68a6674234a8eeef06a0d10fbe9d2db40bcdb531 AS builder

# CVE-2026-3644: requires python-3.13 >= 3.13.12-r7
# CVE-2026-5450/5928: glibc >= 2.43-r7 (forced via apk upgrade)
# pip/poetry/etc are installed from PyPI into the user dir so they can be kept ahead of
# the distro packages; the Wolfi ensurepip wheel (py3-pip-wheel 26.2-r0) is retained so
# "python3 -m venv" keeps working.
# The base image records exact "pkg=version" constraints in /etc/apk/world, which
# makes a plain "apk upgrade" a no-op for those packages: the solver honours the
# pin and leaves them behind. Relaxing the exact pins to bare names first is what
# allows security updates to actually apply. Verified on apk-tools 2 and 3.
# The "=[0-9]" anchor deliberately leaves fuzzy "=~" pins (e.g. nodejs=~24) alone.
RUN sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk add --no-cache --upgrade python-3.13 uv && \
    ln -sf /usr/bin/python3.13 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.13 /usr/bin/python

# local install to /home/nonroot/.local/bin
USER nonroot
ENV POETRY_HOME=/home/nonroot \
    PATH=$PATH:/home/nonroot/.local/bin \
    PYTHONPATH=/home/nonroot/.local/lib/python3/site-packages

RUN python3 -m ensurepip --user --upgrade && \
    python3 -m pip install --no-cache-dir --upgrade --user -v pip poetry cryptography virtualenv

# Remove virtualenv's superseded seed wheels and correct its declared inventory.
#
# virtualenv bundles one pip/setuptools pair per supported Python version under
# virtualenv/seed/wheels/embed. The pair for an older interpreter stays at its
# original version and keeps its original CVEs - verified here as pip 26.0.1
# (CVE-2026-13346, CVE-2026-3219, CVE-2026-6357, CVE-2026-8643) and setuptools
# 82.0.1 (CVE-2026-59890), sitting beside the current pip 26.2.1 and setuptools
# 84.0.0. This image ships a single Python version, so the old pair can never be
# selected, but it is still present for a scanner to find.
#
# Upgrading does not help: virtualenv 21.14.0, the current release, bundles the
# same pair, and virtualenv cannot be dropped because poetry imports it.
# Deleting the wheels alone does not help either - virtualenv ships its own
# CycloneDX SBOM and RECORD, which is the inventory scanners read, and which is
# why the finding is reported with no file path. The script does both, in that
# order, and fails the build if either surface still references a removed
# version. Nothing is version-pinned: it keeps the highest version of each
# project and removes the rest, so a future stale wheel needs no edit here.
#
# Run twice deliberately. The second run must be a no-op and exit 0; that is the
# idempotency check, and it fails the build here rather than in a later rebuild.
COPY --chown=nonroot:nonroot scripts/harden-virtualenv-seeds.py /tmp/harden-virtualenv-seeds.py
RUN python3 /tmp/harden-virtualenv-seeds.py && \
    find /home/nonroot/.local/lib -path '*seed/wheels/embed/*' -name '*.whl' | sort > /tmp/seeds.first && \
    python3 /tmp/harden-virtualenv-seeds.py && \
    find /home/nonroot/.local/lib -path '*seed/wheels/embed/*' -name '*.whl' | sort > /tmp/seeds.second && \
    diff /tmp/seeds.first /tmp/seeds.second && \
    echo "idempotent: second run changed nothing" && \
    rm -f /tmp/harden-virtualenv-seeds.py /tmp/seeds.first /tmp/seeds.second

# Raise pip's own bundled dependencies to their fixed versions:
# msgpack 1.1.2 -> 1.2.1 (GHSA-6v7p-g79w-8964) and pkg_resources removed
# (CVE-2025-47273, CVE-2026-59890 - setuptools dropped it in 82.0.0).
COPY --chown=nonroot:nonroot scripts/harden-pip-vendor.py /tmp/harden-pip-vendor.py
RUN python3 /tmp/harden-pip-vendor.py && rm -f /tmp/harden-pip-vendor.py

# Poetry sets default max workers to num of cpu-cores + 4, but pip max connection pool
# is set at 10 and will discard any above that when installing dependencies
RUN poetry config installer.max-workers 10

# create symlink for correct PYTHONPATH for poetry
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
# sed -E with [0-9]+, not [0-9]: a single-digit class only strips patch
# versions 0-9, so 3.13.14 came out as "3.13.14" instead of "3.13", and
# 3.14 would break the same way at 3.14.10.
RUN python3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n' | sed -E 's/\.[0-9]+$//' > /tmp/python_minor_version.txt && \
PY_VERSION=$(cat /tmp/python_minor_version.txt) && \
ln -s "/home/nonroot/.local/lib/python${PY_VERSION}" /home/nonroot/.local/lib/python3

# save Python, pip, and Poetry versions
RUN echo "python_major_tag=$(python3 --version 2>&1 | awk -F' ' '{split($2, a, "."); print a[1]}' | tr -d '\n')" > /tmp/versions.txt  && \
echo "python_minor_tag=$(cat /tmp/python_minor_version.txt)" >> /tmp/versions.txt && \
echo "python=$(python3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n')" >> /tmp/versions.txt && \
echo "pip=$(pip3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n')" >> /tmp/versions.txt && \
echo "poetry=$(poetry --version 2>&1 | awk -F 'version |\\)' '{print $2}' | sed 's/)$//')" >> /tmp/versions.txt && \
echo "uv=$(uv --version 2>&1 | awk '{print $2}')" >> /tmp/versions.txt

USER root
# CVE-2026-6357 no longer applies: Wolfi's py3-pip-wheel is 26.2-r0, past the 26.1 floor,
# so the bundled ensurepip wheel and its SBOM record are kept. Deleting them previously
# broke "python3 -m venv" for every downstream consumer, because ensurepip sources its
# wheel from /usr/share/python-wheels.
RUN apk del libcurl-openssl4 curl

USER nonroot
RUN python3 --version
